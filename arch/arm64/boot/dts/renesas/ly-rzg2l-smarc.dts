/*
 * Device Tree Source for the RZ/G2L SMARC EVK board
 *
 * Copyright (C) 2021 Renesas Electronics Corp.
 */
#include "r9a07g044l2.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Renesas SMARC EVK based on r9a07g044l2";
	compatible = "renesas,smarc-evk", "renesas,r9a07g044l2", "renesas,r9a07g044";

	aliases {
		ethernet0 = &eth0;
		ethernet1 = &eth1;

		serial0 = &scif0;
		serial1 = &scif1;
		serial2 = &scif2;
		serial3 = &scif3;
		serial4 = &scif4;
		serial5 = &sci0;
		serial6 = &sci1;

		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c3 = &i2c3;

		mmc0 = &sdhi0;
		mmc1 = &sdhi1;

		rspi0 = &spi0;
		rspi1 = &spi1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@48000000 {
		device_type = "memory";
		/* first 128MB is reserved for secure area. */
		reg = <0x0 0x48000000 0x0 0x38000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x10000000>;
		};

		mmp_reserved: linux,multimedia {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0x68000000 0x0 0x8000000>;
		};
	};

	mmngr {
		compatible = "renesas,mmngr";
		memory-region = <&mmp_reserved>;
	};

	mmngrbuf {
		compatible = "renesas,mmngrbuf";
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};

	reg_1p1v: regulator-vdd-core {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.1V";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		emled_run {
			gpios = <&pinctrl RZG2L_GPIO(19, 0) GPIO_ACTIVE_HIGH>;
			label = "EMLED_RUN";
			default-state = "on";
			linux,default-trigger = "none";
		};
	};

	keyboard {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;
		autorepeat;
		status = "disabled";

		key-up {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(46, 0) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_UP>;
			debounce-interval = <20>;
			label = "key_up";
		};

		key-left {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(46, 1) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_LEFT>;
			debounce-interval = <20>;
			label = "key_left";
		};

		key-down {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(46, 2) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_DOWN>;
			debounce-interval = <20>;
			label = "key_down";
		};

		key-right {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(46, 3) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_RIGHT>;
			debounce-interval = <20>;
			label = "key_right";
		};

		key-esc {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(1, 1) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_ESC>;
			debounce-interval = <20>;
			label = "key_esc";
		};

		key-enter {
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(1, 0) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_ENTER>;
			debounce-interval = <20>;
			label = "key_enter";
		};
	};

	ly_st75161 {
		compatible = "ly-st75161";
		lcd-A0-gpios = <&pinctrl RZG2L_GPIO(18, 1) GPIO_ACTIVE_HIGH>;
		lcd-SCLK-gpios = <&pinctrl RZG2L_GPIO(19, 1) GPIO_ACTIVE_HIGH>;
		lcd-MOSI-gpios = <&pinctrl RZG2L_GPIO(19, 0) GPIO_ACTIVE_HIGH>;
		lcd-CSB-gpios = <&pinctrl RZG2L_GPIO(45, 2) GPIO_ACTIVE_HIGH>;
		lcd-RSTB-gpios = <&pinctrl RZG2L_GPIO(18, 0) GPIO_ACTIVE_HIGH>;
		lcd-BL-gpios = <&pinctrl RZG2L_GPIO(45, 3) GPIO_ACTIVE_LOW>;
		status = "disabled";
	};

	ly_power {
		compatible = "ly-power";
		capacitor-discharge-gpios = <&pinctrl RZG2L_GPIO(17, 1) GPIO_ACTIVE_LOW>;
		pfi-gpios = <&pinctrl RZG2L_GPIO(17, 0) GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	ly_watchdog {
		compatible = "ly-watchdog";
		feed-gpios = <&pinctrl RZG2L_GPIO(12, 1) GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	ly_gps {
		compatible = "ly-gps";
		pps-gpios = <&pinctrl RZG2L_GPIO(1, 0) GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};

	pps {
		compatible = "pps-gpio";
		gpios = <&pinctrl RZG2L_GPIO(1, 1) GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&adc {
	pinctrl-names = "default";
	status = "disabled";

	/delete-node/ channel@2;
	/delete-node/ channel@3;
	/delete-node/ channel@4;
	/delete-node/ channel@5;
	/delete-node/ channel@6;
	/delete-node/ channel@7;
};

&eth0 {
	pinctrl-0 = <&eth0_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	phy-mode = "mii";
	linux,ifname = "eth0";
	status = "disabled";

	phy0: ethernet-phy@3 {
		compatible = "ethernet-phy-id0000.0128",
			     "ethernet-phy-ieee802.3-c22";
		reg = <3>;
		rxc-skew-psec = <2400>;
		txc-skew-psec = <2400>;
		rxdv-skew-psec = <0>;
		txdv-skew-psec = <0>;
		rxd0-skew-psec = <0>;
		rxd1-skew-psec = <0>;
		rxd2-skew-psec = <0>;
		rxd3-skew-psec = <0>;
		txd0-skew-psec = <0>;
		txd1-skew-psec = <0>;
		txd2-skew-psec = <0>;
		txd3-skew-psec = <0>;
	};
};

&eth1 {
	pinctrl-0 = <&eth1_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy1>;
	phy-mode = "rgmii-id";
	linux,ifname = "eth1";
	status = "disabled";

	phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-id4f51.e91b",
			     "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		rxc-skew-psec = <0>;
		txc-skew-psec = <1800>;
		rxdv-skew-psec = <0>;
		txen-skew-psec = <0>;
		rxd0-skew-psec = <0>;
		rxd1-skew-psec = <0>;
		rxd2-skew-psec = <0>;
		rxd3-skew-psec = <0>;
		txd0-skew-psec = <0>;
		txd1-skew-psec = <0>;
		txd2-skew-psec = <0>;
		txd3-skew-psec = <0>;
	};
};

&extal_clk {
	clock-frequency = <24000000>;
};

&ostm1 {
	status = "disabled";
};

&ostm2 {
	status = "disabled";
};

&pinctrl {
	can0_pins: can0 {
		pinmux = <RZG2L_PORT_PINMUX(10, 1, 2)>, /* TX */
			 <RZG2L_PORT_PINMUX(11, 0, 2)>; /* RX */
	};

	can1_pins: can1 {
		pinmux = <RZG2L_PORT_PINMUX(12, 1, 2)>, /* TX */
			 <RZG2L_PORT_PINMUX(13, 0, 2)>; /* RX */
	};

	eth0_pins: eth0 {
		pinmux = <RZG2L_PORT_PINMUX(27, 1, 1)>, /* ET0_MDC */
			 <RZG2L_PORT_PINMUX(28, 0, 1)>, /* ET0_MDIO */
			 <RZG2L_PORT_PINMUX(20, 0, 1)>, /* ET0_TXC */
			 <RZG2L_PORT_PINMUX(20, 1, 1)>, /* ET0_TX_CTL */
			 <RZG2L_PORT_PINMUX(20, 2, 1)>, /* ET0_TXD0 */
			 <RZG2L_PORT_PINMUX(21, 0, 1)>, /* ET0_TXD1 */
			 <RZG2L_PORT_PINMUX(21, 1, 1)>, /* ET0_TXD2 */
			 <RZG2L_PORT_PINMUX(22, 0, 1)>, /* ET0_TXD3 */
			 <RZG2L_PORT_PINMUX(22, 1, 1)>,	/* ETH0_TX_ERR */
			 <RZG2L_PORT_PINMUX(23, 0, 1)>,	/* ETH0_TX_COL */
			 <RZG2L_PORT_PINMUX(23, 1, 1)>, /* ETH0_TX_CRS */
			 <RZG2L_PORT_PINMUX(24, 0, 1)>, /* ET0_RXC */
			 <RZG2L_PORT_PINMUX(24, 1, 1)>, /* ET0_RX_CTL */
			 <RZG2L_PORT_PINMUX(25, 0, 1)>, /* ET0_RXD0 */
			 <RZG2L_PORT_PINMUX(25, 1, 1)>, /* ET0_RXD1 */
			 <RZG2L_PORT_PINMUX(26, 0, 1)>, /* ET0_RXD2 */
			 <RZG2L_PORT_PINMUX(26, 1, 1)>, /* ET0_RXD3 */
			 <RZG2L_PORT_PINMUX(27, 0, 1)>; /* ETH0_RX_ERR */
	};

	eth1_pins: eth1 {
		txc {
			pinmux = <RZG2L_PORT_PINMUX(29, 0, 1)>; /* ET1_TXC */
			power-source = <3300>;
			output-enable;
		};

		mux {
			pinmux = <RZG2L_PORT_PINMUX(37, 0, 1)>, /* ET1_MDC */
					<RZG2L_PORT_PINMUX(37, 1, 1)>, /* ET1_MDIO */
					<RZG2L_PORT_PINMUX(29, 1, 1)>, /* ET1_TX_CTL */
					<RZG2L_PORT_PINMUX(30, 0, 1)>, /* ET1_TXD0 */
					<RZG2L_PORT_PINMUX(30, 1, 1)>, /* ET1_TXD1 */
					<RZG2L_PORT_PINMUX(31, 0, 1)>, /* ET1_TXD2 */
					<RZG2L_PORT_PINMUX(31, 1, 1)>, /* ET1_TXD3 */
					<RZG2L_PORT_PINMUX(33, 1, 1)>, /* ET1_RXC */
					<RZG2L_PORT_PINMUX(34, 0, 1)>, /* ET1_RX_CTL */
					<RZG2L_PORT_PINMUX(34, 1, 1)>, /* ET1_RXD0 */
					<RZG2L_PORT_PINMUX(35, 0, 1)>, /* ET1_RXD1 */
					<RZG2L_PORT_PINMUX(35, 1, 1)>, /* ET1_RXD2 */
					<RZG2L_PORT_PINMUX(36, 0, 1)>; /* ET1_RXD3 */
			power-source = <3300>;                                                                                                           
		};
	};

	sdhi0_emmc_pins: sd0emmc {
		sd0_emmc_data {
			pins = "SD0_DATA0", "SD0_DATA1", "SD0_DATA2", "SD0_DATA3",
			       "SD0_DATA4", "SD0_DATA5", "SD0_DATA6", "SD0_DATA7";
			power-source = <1800>;
		};

		sd0_emmc_ctrl {
			pins = "SD0_CLK", "SD0_CMD";
			power-source = <1800>;
		};

		sd0_emmc_rst {
			pins = "SD0_RST#";
			power-source = <1800>;
		};
	};

	sdhi1_pins: sd1 {
		sd1_data {
			pins = "SD1_DATA0", "SD1_DATA1", "SD1_DATA2", "SD1_DATA3";
			power-source = <3300>;
		};

		sd1_ctrl {
			pins = "SD1_CLK", "SD1_CMD";
			power-source = <3300>;
		};
	};

	i2c0_pins: i2c0 {
		pins = "RIIC0_SDA", "RIIC0_SCL";
		input-enable;
	};

	i2c1_pins: i2c1 {
		pins = "RIIC1_SDA", "RIIC1_SCL";
		input-enable;
	};

	i2c2_pins: i2c2 {
		pinmux = <RZG2L_PORT_PINMUX(19, 0, 4)>, /* SDA */
			 <RZG2L_PORT_PINMUX(19, 1, 4)>; /* SCL */
	};

	i2c3_pins: i2c3 {
		pinmux = <RZG2L_PORT_PINMUX(8, 1, 4)>, /* SDA */
			 <RZG2L_PORT_PINMUX(8, 0, 4)>; /* SCL */
	};

	scif0_pins: scif0 {
		pinmux = <RZG2L_PORT_PINMUX(38, 0, 1)>,	/* TxD */
			 <RZG2L_PORT_PINMUX(38, 1, 1)>;	/* RxD */
	};

	scif1_pins: scif1 {
		pinmux = <RZG2L_PORT_PINMUX(40, 0, 1)>,	/* TxD */
			 <RZG2L_PORT_PINMUX(40, 1, 1)>;	/* RxD */
	};

	scif2_pins: scif2 {
		pinmux = <RZG2L_PORT_PINMUX(48, 0, 1)>,	/* TxD */
			 <RZG2L_PORT_PINMUX(48, 1, 1)>,	/* RxD */
			 <RZG2L_PORT_PINMUX(48, 3, 1)>, /* CTS# */
			 <RZG2L_PORT_PINMUX(48, 4, 1)>; /* RTS# */
	};

	scif3_pins: scif3 {
		pinmux = <RZG2L_PORT_PINMUX(0, 0, 5)>,	/* TxD */
			 <RZG2L_PORT_PINMUX(0, 1, 5)>;	/* RxD */
	};

	scif4_pins: scif4 {
		pinmux = <RZG2L_PORT_PINMUX(2, 0, 5)>,	/* TxD */
			 <RZG2L_PORT_PINMUX(2, 1, 5)>;	/* RxD */
	};

	sci0_pins: sci0 {
		pinmux = <RZG2L_PORT_PINMUX(47, 1, 1)>, /* TxD */
			 <RZG2L_PORT_PINMUX(47, 0, 1)>; /* RxD */
	};

	sci1_pins: sci1 {
		pinmux = <RZG2L_PORT_PINMUX(45, 1, 3)>, /* TxD */
			 <RZG2L_PORT_PINMUX(45, 0, 3)>; /* RxD */
	};

	spi0_pins: spi0 {
		pinmux = <RZG2L_PORT_PINMUX(43, 0, 1)>, /* CK */
			 <RZG2L_PORT_PINMUX(43, 1, 1)>, /* MOSI */
			 <RZG2L_PORT_PINMUX(43, 2, 1)>, /* MISO */
			 <RZG2L_PORT_PINMUX(43, 3, 1)>; /* SSL */
	};

	spi1_pins: spi1 {
		pinmux = <RZG2L_PORT_PINMUX(44, 0, 1)>, /* CK */
			 <RZG2L_PORT_PINMUX(44, 1, 1)>, /* MOSI */
			 <RZG2L_PORT_PINMUX(44, 2, 1)>; /* MISO */
	};

	usb0_pins: usb0 {
		pinmux = <RZG2L_PORT_PINMUX(4, 0, 1)>, /* VBUS */
			 <RZG2L_PORT_PINMUX(5, 0, 1)>; /* OVC */
	};

	usb1_pins: usb1 {
		pinmux = <RZG2L_PORT_PINMUX(42, 0, 1)>, /* VBUS */
			 <RZG2L_PORT_PINMUX(42, 1, 1)>; /* OVC */
	};

};

&canfd {
	pinctrl-0 = <&can0_pins &can1_pins>;
	pinctrl-names = "default";
	status = "disabled";

	channel0 {
		status = "disabled";
	};

	channel1 {
		status = "disabled";
	};
};

&ehci0 {
	dr_mode = "host";
	status = "okay";

	memory-region = <&global_cma>;
};

&ehci1 {
	status = "okay";
	dr_mode = "host";

	memory-region = <&global_cma>;
};

&ohci0 {
	dr_mode = "host";
	status = "okay";

	memory-region = <&global_cma>;
};

&ohci1 {
	dr_mode = "host";
	status = "okay";

	memory-region = <&global_cma>;
};

&phyrst {
	status = "okay";
};

&wdt0 {
	status = "okay";
	timeout-sec = <60>;
};

&gpu {
	mali-supply = <&reg_1p1v>;
	status = "disabled";
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c2 {
	pinctrl-0 = <&i2c2_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "disabled";

	rx8025t: rx8025t@32 {
		compatible = "epson,rx8025t";
		reg = <0x32>;
		status = "disabled";
	};
};

&scif0 {
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";
	dmas = <&dmac 0x4e79>, <&dmac 0x4e7a>;
	dma-names = "tx", "rx";
	status = "okay";
};

&scif1 {
	pinctrl-0 = <&scif1_pins>;
	pinctrl-names = "default";
	rs485-enabled;
	rs485-gpios = <&pinctrl RZG2L_GPIO(40, 2) GPIO_ACTIVE_LOW>;
	status = "disabled";
};

&scif2 {
	pinctrl-0 = <&scif2_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "disabled";
};

&scif3 {
	pinctrl-0 = <&scif3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&scif4 {
	pinctrl-0 = <&scif4_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&sci0 {
	pinctrl-0 = <&sci0_pins>;
	pinctrl-names = "default";
	status = "disabled";
};

&sci1 {
	pinctrl-0 = <&sci1_pins>;
	pinctrl-names = "default";
	status = "disabled";
};

&sdhi0 {
	pinctrl-0 = <&sdhi0_emmc_pins>;
	pinctrl-1 = <&sdhi0_emmc_pins>;
	pinctrl-names = "default", "state_uhs";

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

&sdhi1 {
	pinctrl-0 = <&sdhi1_pins>;
	pinctrl-names = "default";
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_3p3v>;
	bus-width = <4>;
	disable-wp;
	no-mmc;
	no-sd;
	non-removable;
	no-1-8-v;
	status = "okay";
};

&spi0 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	spi-slave;
	status = "disabled";
	slave {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-cpha;
		status = "okay";
	};
};

&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";
	spi-slave;
	status = "okay";
	slave {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-cpha;
		status = "okay";
	};
};

&usb2_phy0 {
	pinctrl-0 = <&usb0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&usb2_phy1 {
	pinctrl-0 = <&usb1_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&mtu3 {
	status = "disabled";
};

&cru {
	status = "disabled";
};
